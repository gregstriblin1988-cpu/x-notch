#!/usr/bin/env python3
"""xnotch-fetch <handle>: print JSON feed for an X handle. Uses bearer token in ~/.config/xnotch/token (X API v2).
Output: {"status": "ok"|"no_token"|"error", "handle":..., "posts":[...], "message":...}. Cached 10 min in ~/.cache/xnotch."""
import json, os, re, sys, time, urllib.request, urllib.parse
h = re.sub(r'[^A-Za-z0-9_]', '', sys.argv[1] if len(sys.argv) > 1 else '')
out = lambda o: (print(json.dumps(o)), sys.exit(0))
if not h: out({"status": "error", "handle": "", "posts": [], "message": "no handle"})
tokf = os.path.expanduser('~/.config/xnotch/token')
tok = open(tokf).read().strip() if os.path.exists(tokf) else ''
if not tok: out({"status": "no_token", "handle": h, "posts": []})
cache = os.path.expanduser(f'~/.cache/xnotch/{h}.feed.json')
if os.path.exists(cache) and time.time() - os.path.getmtime(cache) < 600:
    print(open(cache).read()); sys.exit(0)
def get(url):
    r = urllib.request.Request(url, headers={"Authorization": f"Bearer {tok}", "User-Agent": "xnotch"})
    with urllib.request.urlopen(r, timeout=15) as f: return json.load(f)
try:
    u = get(f"https://api.x.com/2/users/by/username/{h}?user.fields=name")["data"]
    t = get(f"https://api.x.com/2/users/{u['id']}/tweets?max_results=10&exclude=replies&tweet.fields=created_at,public_metrics")
    posts = [{"name": u.get("name", h), "handle": h, "text": p["text"], "created_at": p.get("created_at", ""),
              "replies": p.get("public_metrics", {}).get("reply_count", 0), "reposts": p.get("public_metrics", {}).get("retweet_count", 0),
              "likes": p.get("public_metrics", {}).get("like_count", 0), "id": p["id"]} for p in t.get("data", [])]
    o = {"status": "ok", "handle": h, "posts": posts}
    open(cache, 'w').write(json.dumps(o)); out(o)
except Exception as e:
    if os.path.exists(cache): print(open(cache).read()); sys.exit(0)
    out({"status": "error", "handle": h, "posts": [], "message": str(e)[:200]})
